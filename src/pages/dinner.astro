---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import site from '../content/site.json';
import home from '../content/home.json';

const status = site.dinnerStatus as 'soon' | 'open' | 'closed';
const endpoint = site.inviteFormEndpoint;
const live = status === 'open' && Boolean(endpoint);

const fields = [
  { id: 'name', label: 'Full name', type: 'text', autocomplete: 'name', required: true },
  { id: 'title', label: 'Title', type: 'text', autocomplete: 'organization-title', required: true },
  { id: 'institution', label: 'Institution', type: 'text', autocomplete: 'organization', required: true },
  { id: 'email', label: 'Work email', type: 'email', autocomplete: 'email', required: true },
  { id: 'linkedin', label: 'LinkedIn profile', type: 'url', autocomplete: 'url', required: false, hint: 'Optional. Helps us confirm invitations quickly.' },
];
---

<Base
  title="ETHIndia Institutional Dinner — 4 Nov 2026, Mumbai"
  description="A closed-door dinner during Devcon 8 in Mumbai for senior people at Indian banks, asset managers, market infrastructure institutions and regulators. By invitation."
>
  <PageHead
    title={home.dinner.title}
    lede={home.dinner.body}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Dinner', href: '/dinner' }]}
  >
    <dl class="dinner-facts">
      <div><dt class="meta">Date</dt><dd class="px">{site.dinner.date}</dd></div>
      <div><dt class="meta">Time</dt><dd class="px">{site.dinner.time}</dd></div>
      <div><dt class="meta">Place</dt><dd class="px">{site.dinner.place}</dd></div>
    </dl>
  </PageHead>

  <section class="section" aria-labelledby="request-title">
    <div class="wrap request">
      <div class="request__intro">
        <h2 id="request-title" class="request__title">Request an invitation</h2>
        {status === 'soon' && (
          <p>Invite requests open soon. The form below shows what we will ask. <a href="/#subscribe">Get notified when requests open</a>.</p>
        )}
        {status === 'open' && (
          <p>Tell us who you are and what you work on. Each request is reviewed and confirmed individually; the venue is shared with confirmed guests.</p>
        )}
        {status === 'closed' && <p>Invite requests are closed. Thank you to everyone who applied.</p>}
        {status === 'open' && !endpoint && (
          <p class="todo">TODO: invite form endpoint (Tally / Formspree). Set inviteFormEndpoint in site.json.</p>
        )}
      </div>

      {status !== 'closed' && (
        <form class="panel request__form" method="post" action={live ? endpoint : undefined} aria-describedby="request-title">
          <fieldset disabled={!live}>
            <legend class="visually-hidden">Your details</legend>
            <div class="request__grid">
              {fields.map((f) => (
                <div class="field">
                  <label for={`invite-${f.id}`}>{f.label}{!f.required && <span class="meta"> (optional)</span>}</label>
                  <input
                    id={`invite-${f.id}`}
                    name={f.id}
                    type={f.type}
                    autocomplete={f.autocomplete}
                    required={f.required}
                    aria-describedby={f.hint ? `invite-${f.id}-hint` : undefined}
                  />
                  {f.hint && <p class="field__hint" id={`invite-${f.id}-hint`}>{f.hint}</p>}
                </div>
              ))}
              <div class="field request__wide">
                <label for="invite-note">A short note <span class="meta">(optional)</span></label>
                <textarea id="invite-note" name="note" rows="4" maxlength="600" aria-describedby="invite-note-hint"></textarea>
                <p class="field__hint" id="invite-note-hint">What you are working on or would like to discuss. Up to 600 characters.</p>
              </div>
            </div>
            <div class="request__submit">
              <button class="btn" type="submit">{live ? 'Request an invite' : 'Invite requests open soon'}</button>
              <p class="meta">We use these details only to review your request. See the <a href="/privacy">privacy policy</a>.</p>
            </div>
          </fieldset>
        </form>
      )}
    </div>
  </section>
</Base>

<style>
  .dinner-facts { display: flex; flex-wrap: wrap; gap: 16px clamp(24px, 4vw, 56px); margin-top: 8px; }
  .dinner-facts div { display: grid; gap: 2px; }
  .dinner-facts dd { margin: 0; font-size: clamp(17px, 1.5vw, 20px); text-transform: uppercase; letter-spacing: 0.05em; }

  .request { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .request__intro { display: grid; gap: 16px; }
  .request__title { font-size: clamp(28px, 3vw, 40px); }

  .request__form { padding: clamp(20px, 3vw, 36px); }
  .request__form fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .request__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .request__wide { grid-column: 1 / -1; }
  .request__submit { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 24px; }
  .request__submit .meta { max-width: 40ch; }
  .request__form fieldset:disabled label { color: var(--ink-2); }

  @media (max-width: 860px) {
    .request { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .request__grid { grid-template-columns: 1fr; }
  }
</style>
