---
import Base from '../layouts/Base.astro';
---

<Base chrome="narrative" title="Page not found — ETHIndia Institutions" description="This page does not exist." noindex>
  <section class="nf deep">
    <div class="wrap nf__inner">
      <h1>This page isn't here.</h1>
      <p>It may have moved. Everything that was on the old portal is still on this site.</p>
      <div class="nf__actions">
        <a class="btn" href="/briefing">Go to the briefing</a>
        <a class="btn btn--secondary" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(56px, 10vw, 140px); }
  .nf__inner { display: grid; gap: 20px; }
  .nf h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
