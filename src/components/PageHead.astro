---
// Header band for inner pages: optional breadcrumb, H1, lede, and a slot for actions/meta.
interface Props {
  title: string;
  lede?: string;
  crumbs?: { label: string; href: string }[];
}
const { title, lede, crumbs = [] } = Astro.props;
---

<section class="page-head deep" aria-labelledby="page-title">
  <div class="wrap page-head__inner">
    {crumbs.length > 0 && (
      <nav class="page-head__crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
        </ol>
      </nav>
    )}
    <h1 id="page-title" class="page-head__title">{title}</h1>
    {lede && <p class="page-head__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head { border-bottom: 1px solid var(--border); padding-block: clamp(40px, 6vw, 88px) clamp(36px, 5vw, 64px); }
  .page-head__inner { display: grid; gap: 20px; }
  .page-head__title { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; max-width: 20ch; }
  .page-head__lede { font-size: clamp(18px, 1.5vw, 21px); color: var(--ink-2); max-width: 60ch; }

  .page-head__crumbs ol { display: flex; flex-wrap: wrap; gap: 4px 0; font-size: 14px; color: var(--ink-2); }
  .page-head__crumbs li + li::before { content: "/"; padding-inline: 10px; color: var(--rule); }
  .page-head__crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -12px;
    text-decoration: none;
  }
  .page-head__crumbs a:hover { color: var(--ink); text-decoration: underline; }
</style>
