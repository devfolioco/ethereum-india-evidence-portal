---
import site from '../content/site.json';

const items = site.ticker;
// Two identical runs so the marquee loops seamlessly at -50%.
const runs = [items, items];
---

<div class="ticker band" id="ticker">
  <h2 class="visually-hidden">Announcements</h2>
  <button class="ticker__pause" type="button" data-ticker-pause aria-label="Pause announcements">
    <span aria-hidden="true" data-pause-glyph>❙❙</span>
  </button>
  <div class="ticker__viewport">
    <div class="ticker__track">
      {runs.map((run, r) => (
        <ul class="ticker__run" aria-hidden={r > 0 ? "true" : undefined} inert={r > 0}>
          {run.map((item) => (
            <li class="ticker__item">
              <a href={item.href}>{item.text} <span aria-hidden="true">↗</span></a>
              <span class="ticker__sep" aria-hidden="true">◆</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  .ticker {
    position: relative;
    display: flex;
    align-items: stretch;
    height: var(--ticker-h);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-pixel);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .ticker__viewport { overflow: hidden; flex: 1; }

  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 70s linear infinite;
  }
  .ticker:hover .ticker__track,
  .ticker:focus-within .ticker__track,
  .ticker[data-paused] .ticker__track { animation-play-state: paused; }

  .ticker__run { display: flex; align-items: center; }

  .ticker__item { display: flex; align-items: center; height: var(--ticker-h); }
  .ticker__item a { text-decoration: none; white-space: nowrap; }
  .ticker__item a:hover { text-decoration: underline; }
  .ticker__sep { padding-inline: 1.5rem; color: var(--accent); }

  .ticker__pause {
    flex: none;
    width: 34px;
    background: var(--paper);
    border: 0;
    border-right: 1px solid var(--border);
    font-size: 11px;
    cursor: pointer;
  }
  .ticker__pause:focus-visible { outline: 2px solid var(--ink); outline-offset: -4px; }

  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track { animation: none; }
    .ticker__pause { display: none; }
  }
</style>

<script>
  const ticker = document.getElementById('ticker');
  const button = ticker?.querySelector<HTMLButtonElement>('[data-ticker-pause]');
  const glyph = ticker?.querySelector<HTMLElement>('[data-pause-glyph]');

  button?.addEventListener('click', () => {
    const paused = ticker!.toggleAttribute('data-paused');
    button.setAttribute('aria-label', paused ? 'Play announcements' : 'Pause announcements');
    if (glyph) glyph.textContent = paused ? '▶' : '❙❙';
  });
</script>
