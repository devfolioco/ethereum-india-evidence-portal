---
import site from '../../content/site.json';
import IndiaMap from './IndiaMap.astro';

const { hero } = site;
// "[x]" in the title marks a letter set in the pixel face (glyph swap).
const parts = hero.title.split(/\[(.)\]/);
const plainTitle = parts.join('');
---

<section class="hero deep" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="label">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title" aria-label={plainTitle}>
        <span aria-hidden="true">
          {parts.map((part, i) => (i % 2 ? <span class="px">{part}</span> : part))}
        </span>
      </h1>
      <p class="hero__sub">{hero.sub}</p>
      <div class="hero__ctas">
        <a class="btn" href={hero.primary.href}>{hero.primary.label}</a>
        <a class="btn btn--secondary" href={hero.secondary.href}>
          {hero.secondary.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hero__art">
      <IndiaMap />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(32px, 5vw, 72px); border-bottom: 1px solid var(--border); }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }

  .hero__title {
    margin-top: 20px;
    /* Two-column hero: the brief's 7vw display size would overflow the copy column. */
    font-size: clamp(44px, 5.6vw, 92px);
  }
  .hero__title .px { letter-spacing: -0.04em; }

  .hero__sub {
    margin-top: 28px;
    max-width: 34em;
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--ink-2);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__art { max-width: 560px; justify-self: end; width: 100%; }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__art { justify-self: center; max-width: 440px; }
  }
</style>
