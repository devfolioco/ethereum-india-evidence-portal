---
import home from '../../content/home.json';
import IndiaMap from './IndiaMap.astro';
import PixelRupee from './PixelRupee.astro';

const { hero } = home;
// Pixel accents and the rupee substitution are visual; the accessible title uses the original wording.
const marked = hero.title
  .replace('Ethereum', 'Ethe[₹]eum')
  .replace('Institutional', 'Instit[u]tional')
  .replace('Finance', 'Fin[a]nce')
  .replace('India', 'In[d]ia');
const parts = marked.split(/\[(.)\]/);
---

<section class="hero deep" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="visually-hidden">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title" aria-label={hero.title}>
        <span aria-hidden="true">
          {parts.map((part, i) => (i % 2 ? (part === '₹' ? <PixelRupee /> : <span class="px">{part}</span>) : part))}
        </span>
      </h1>
      <p class="hero__sub">{hero.sub}</p>
      <a class="btn hero__interest" href="#interest">Sign up<span aria-hidden="true"> →</span></a>
    </div>

    <div class="hero__art">
      <IndiaMap />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(40px, 6vw, 88px); }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
  }

  .hero__title {
    font-size: clamp(44px, 5.6vw, 92px);
  }
  .hero__title .px { letter-spacing: -0.04em; }

  .hero__sub {
    margin-top: 28px;
    max-width: 34em;
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--ink-2);
  }

  .hero__art { max-width: 560px; justify-self: end; width: 100%; }
  .hero__interest { margin-top: 28px; }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__art { justify-self: center; max-width: 440px; }
  }

  /* Entrance: the title rises out of its baseline while the ruling draws down (base.css),
     then the sentence settles and the map surfaces. On leaving, copy and map drift apart. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title { animation: title-rise 1100ms var(--ease-out) 200ms both; }
    .hero__sub { animation: settle 900ms var(--ease-out) 650ms both; }
    .hero__art { animation: surface 1400ms var(--ease-out) 350ms both; }

    @supports (animation-timeline: view()) {
      .hero__copy, .hero__art > :global(*) {
        animation: var(--leave) linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      .hero__copy { --leave: copy-leave; }
      .hero__art > :global(*) { --leave: art-leave; }
    }
  }
  @keyframes title-rise {
    from { clip-path: inset(100% 0 -0.2em 0); transform: translateY(0.35em); }
    to { clip-path: inset(-0.2em 0 -0.2em 0); transform: none; }
  }
  @keyframes settle {
    from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes surface {
    from { opacity: 0; transform: scale(0.94); }
    to { opacity: 1; transform: none; }
  }
  @keyframes copy-leave { to { transform: translateY(-14vh); opacity: 0.15; } }
  @keyframes art-leave { to { transform: translateY(10vh) scale(0.92); opacity: 0.25; } }
</style>
