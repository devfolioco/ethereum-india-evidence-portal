---
import Base from '../layouts/Base.astro';
import Hero from '../components/hero/Hero.astro';
import home from '../content/home.json';
import '../styles/prose.css';

const { whyIndia, ethereum, expect, briefing, dinner, updates } = home;
---

<Base>
  <Hero />

  <section class="section" id="why-india" aria-labelledby="why-india-title">
    <div class="wrap">
      <p class="runhead">{whyIndia.eyebrow}</p>
      <div class="section__head">
                <h2 id="why-india-title">{whyIndia.title}</h2>
      </div>
      <ul class="points">
        {whyIndia.points.map((p) => (
          <li class="point">
            <h3>{p.title}</h3>
            <p set:html={p.html} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="ethereum" aria-labelledby="ethereum-title">
    <div class="wrap">
      <p class="runhead">{ethereum.eyebrow}</p>
      <div class="split">
        <div class="section__head">
                    <h2 id="ethereum-title">{ethereum.title}</h2>
        </div>
        <div class="split__body">
          {ethereum.paragraphs.map((t) => <p>{t}</p>)}
          <p class="deeper">
            {ethereum.links.map((l) => <a href={l.href}>{l.label}<span aria-hidden="true"> →</span></a>)}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="expect" aria-labelledby="expect-title">
    <div class="wrap">
      <p class="runhead">{expect.eyebrow}</p>
      <div class="section__head">
                <h2 id="expect-title">{expect.title}</h2>
      </div>
      <ul class="cols">
        {expect.items.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="briefing" aria-labelledby="briefing-title">
    <div class="wrap">
      <p class="runhead">{briefing.eyebrow}</p>
      <div class="section__head">
                <h2 id="briefing-title">{briefing.title}</h2>
      </div>
      <article class="report">
        <p class="report__date meta"><time datetime={briefing.iso}>{briefing.date}</time></p>
        <h3 class="report__title"><a href="/briefing">{briefing.reportTitle}</a></h3>
        <p class="report__sub">{briefing.sub}</p>
        <p class="report__summary">{briefing.summary}</p>
        <div class="report__actions">
          <a class="btn" href="/briefing">{briefing.read}<span aria-hidden="true"> →</span></a>
          <a class="rlink" href="/briefing/ledger">{briefing.ledger}</a>
        </div>
      </article>
    </div>
  </section>

  <section class="dinner band" id="dinner" aria-labelledby="dinner-title">
    <div class="wrap dinner__inner">
      <div class="dinner__text">
        <h2 id="dinner-title">{dinner.title}</h2>
        <p>{dinner.body}</p>
      </div>
      <div class="dinner__card">
        <p class="dinner__when px"><time datetime={dinner.iso}>{dinner.when.split(', ').map((part, i, all) => i < all.length - 1 ? <><span>{part},</span> </> : <span>{part}</span>)}</time></p>
        <p class="dinner__occasion">{dinner.eyebrow}</p>
        <p class="dinner__where">{dinner.where}</p>
        <div class="dinner__cta">
          <span class="btn" aria-disabled="true">{dinner.pending}</span>
          <p class="dinner__access">{dinner.access}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="updates" aria-labelledby="updates-title">
    <div class="wrap">
      <p class="runhead">{updates.eyebrow}</p>
      <div class="section__head">
                <h2 id="updates-title">{updates.title}</h2>
      </div>
      <ol class="updates">
        {updates.items.map((u) => (
          <li class="updates__item">
            <p class="updates__meta">
              <time datetime={u.iso}>{u.date}</time>
              <span class="updates__type">{u.type}</span>
            </p>
            <div>
              <h3><a href={u.href}>{u.title}</a></h3>
              <p class="updates__summary">{u.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  h3 { margin: 0; }
  .section__head { display: grid; gap: 14px; margin-bottom: clamp(28px, 4vw, 48px); }
  .split .section__head { margin-bottom: 0; align-content: start; }

  /* Why India: four claims on the page's own column ruling.
     The headline sits in the left half, the sentence in the right half, first baselines shared. */
  .points { border-top: 1px solid var(--border); }
  .point {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: baseline;
    padding-block: clamp(28px, 3.4vw, 48px);
    border-bottom: 1px solid var(--border);
  }
  .point h3 {
    max-width: 18ch;
    font-size: clamp(28px, 3.1vw, 42px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .point p { max-width: 46ch; padding-left: var(--hair-pad); font-size: clamp(18px, 1.5vw, 20px); line-height: 1.55; }

  /* Where Ethereum fits */
  .split {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  .split > :last-child { padding-left: var(--hair-pad); }
  .split__body { display: grid; gap: 20px; max-width: 56ch; font-size: clamp(18px, 1.5vw, 20px); line-height: 1.55; }
  .deeper { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  .deeper { align-items: center; padding-top: 4px; }

  /* On this site */
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px 0; }
  .cols > li { display: grid; align-content: start; gap: 8px; padding: 16px var(--hair-pad) 0 0; border-top: 1px solid var(--ink); }
  .cols h3 { font-size: 22px; font-weight: 500; letter-spacing: -0.01em; }
  .cols p { font-size: 16px; line-height: 1.5; color: var(--ink-2); }

  /* Briefing */
  .report {
    display: grid;
    gap: 14px;
    max-width: 820px;
    padding: clamp(24px, 4vw, 48px);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }
  .report__title { font-size: clamp(28px, 3.2vw, 44px); line-height: 1.1; font-weight: 500; }
  .report__title a { text-decoration: none; }
  .report__title a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .report__sub { font-size: clamp(18px, 1.6vw, 22px); color: var(--ink-2); }
  .report__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 12px; }
  .report__actions .rlink { font-size: 15px; }

  /* Dinner band */
  .dinner { padding-block: clamp(56px, 8vw, 112px); }
  .dinner__inner {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }
  .dinner__text { padding-right: clamp(24px, 4vw, 56px); }
  .dinner__card { margin-left: var(--hair-pad); }
  .dinner__text { display: grid; gap: 18px; }
  .dinner__text p:last-child { max-width: 52ch; }
  .dinner__card { display: grid; gap: 12px; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--border); background: var(--panel); }
  .dinner__when { font-size: clamp(22px, 2.2vw, 30px); line-height: 1.15; }
  .dinner__when span { white-space: nowrap; } /* break after the weekday, never inside the date */
  .dinner__occasion { font-size: 18px; }
  .dinner__where { color: var(--ink-2); }
  .dinner__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 10px; }
  .dinner__access { font-size: 15px; color: var(--ink-2); }

  /* Updates */
  .updates { border-top: 1px solid var(--border); max-width: 880px; }
  .updates__item {
    display: grid;
    grid-template-columns: 11em 1fr;
    gap: 8px 24px;
    padding-block: 20px;
    border-bottom: 1px solid var(--border);
  }
  .updates__meta { display: grid; gap: 2px; align-content: start; padding-top: 5px; font-size: 15px; color: var(--ink-2); }
  .updates__type { font-size: 14px; }
  .updates__type::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 8px; vertical-align: 0.12em; background: var(--accent); }
  .updates h3 { font-size: 22px; font-weight: 500; }
  .updates h3 a { text-decoration: none; }
  .updates h3 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .updates__summary { margin-top: 6px; color: var(--ink-2); font-size: 16px; }

  @media (max-width: 860px) {
    .point, .split, .dinner__inner { grid-template-columns: 1fr; row-gap: 14px; }
    .point p, .split > :last-child { padding-left: 0; margin-left: 0; }
    .dinner__inner { row-gap: 32px; }
    .dinner__card { margin-left: 0; }
    .dinner__text { padding-right: 0; }
    .cols { grid-template-columns: 1fr; }
    .cols > li { padding-right: 0; }
  }
  @media (max-width: 560px) {
    .updates__item { grid-template-columns: 1fr; }
  }
</style>
