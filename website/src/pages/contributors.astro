---
import Base from '../layouts/Base.astro';
import contributors from '../content/contributors.json';

// Not on the old portal: a user-approved addition, linked only from the footer note.
// photo is a path under public/ (e.g. /contributors/name.webp); empty shows initials.
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---

<Base chrome="narrative" title="Contributors: ETHIndia Institutional" description="The people behind ETHIndia Institutional.">
  <header class="contrib-head deep">
    <div class="wrap contrib-head__inner">
      <a class="rlink" href="/">Home</a>
      <h1>Contributors</h1>
      <p class="contrib-lede">ETHIndia Institutional runs briefings, convenings and coordination on Ethereum for Indian banks, market infrastructure and regulators. The people behind it:</p>
    </div>
  </header>
  <section class="contrib">
    <ul class="wrap contrib__list">
      {contributors.map((c) => (
        <li class="contrib__person">
          {c.photo
            ? <img class="contrib__pic" src={c.photo} alt="" width="64" height="64" loading="lazy" decoding="async" />
            : <span class="contrib__pic contrib__pic--initials" aria-hidden="true">{initials(c.name)}</span>}
          <div>
            <p class="contrib__name">{c.name}</p>
            <p class="meta">{c.title}</p>
            <p class="contrib__rel">{c.relevance}</p>
            <p class="contrib__links meta">
              <a href={c.linkedin} rel="me noopener" aria-label={`${c.name} on LinkedIn`}>LinkedIn</a>
              <a href={c.x} rel="me noopener" aria-label={`${c.name} on X`}>X</a>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .contrib-head { padding-block: clamp(40px, 7vw, 96px) clamp(32px, 5vw, 64px); }
  .contrib-head__inner { display: grid; gap: 16px; justify-items: start; }
  .contrib-head h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1.02; }
  .contrib-lede { color: var(--ink-2); max-width: var(--measure); }
  .contrib { padding-block: clamp(40px, 6vw, 80px); }
  .contrib__list { display: grid; gap: clamp(32px, 4vw, 48px) clamp(32px, 5vw, 72px); }
  @media (min-width: 768px) { .contrib__list { grid-template-columns: 1fr 1fr; } }
  .contrib__person { display: grid; grid-template-columns: 64px 1fr; gap: 20px; align-items: start; }
  .contrib__pic { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; background: var(--surface); }
  .contrib__pic--initials { display: grid; place-items: center; font-size: 18px; color: var(--ink-2); }
  .contrib__name { font-size: 18px; font-weight: 500; }
  .contrib__rel { margin-top: 8px; color: var(--ink-2); max-width: 48ch; }
  .contrib__links { display: flex; gap: 20px; margin-top: 4px; }
  .contrib__links a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; }
  .contrib__links a:hover { color: var(--ink); }
</style>
